---
import PracticeLayout from '@/layouts/PracticeLayout.astro';
import SpeedDrillSetup from '@/components/SpeedDrillSetup';
import InternalLinks from '@/components/InternalLinks';
import { ORGANIZATION_ID } from '@/config/site';
import '@/styles/practice-surface-prototype.css';

const SITE = 'https://mathpracticeonline.com';

const links = [
  { href: '/multiplication/facts/', label: 'Multiplication Facts', description: 'Untimed × facts drill' },
  { href: '/division/facts/', label: 'Division Facts', description: 'Untimed ÷ facts drill' },
  { href: '/addition/', label: 'Addition Practice', description: 'Build adding speed before drilling' },
];

const faqItems = [
  {
    q: 'What is the Arithmetic Speed Drill?',
    a: 'A 60-second test of arithmetic fact fluency. Choose addition, subtraction, multiplication, division, or any combination, with numbers 1–12, and answer as many facts as you can before time runs out.',
  },
  {
    q: 'How is my score calculated?',
    a: 'Your score is the number of problems you answer correctly before the 60-second timer runs out. Wrong answers don\'t subtract from your score — they simply don\'t count toward it.',
  },
  {
    q: 'Can I practice only one operation?',
    a: 'Yes. Deselect the operations you don\'t want before starting — at least one must stay selected. Drilling a single operation is a good way to target your weakest area.',
  },
  {
    q: 'Does the drill save my Personal Best?',
    a: 'Yes. Your Personal Best is saved automatically in your browser — no account or login required — and shown at the start of each session and on your results.',
  },
  {
    q: 'Should I practice untimed before using the Speed Drill?',
    a: 'If you\'re still building recall, untimed practice can help you learn the facts before adding time pressure. Try the multiplication or division facts pages first, then come back to the drill.',
  },
];
---

<PracticeLayout
  title="Arithmetic Speed Drill — 60-Second Math Challenge | Math Practice Online"
  description="How many arithmetic problems can you answer in 60 seconds? Choose addition, subtraction, multiplication, and division facts 1–12. Free online speed drill with personal best tracking."
  canonical={`${SITE}/arithmetic-speed-drill`}
  pilotLayout
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Arithmetic Speed Drill' }]}
  breadcrumbVisual={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(({ q, a }) => ({
        "@type": "Question",
        "name": q,
        "acceptedAnswer": { "@type": "Answer", "text": a }
      }))
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LearningResource",
      "name": "Arithmetic Speed Drill",
      "description": "60-second arithmetic speed drill. Choose addition, subtraction, multiplication, and division facts 1–12. Free with personal best tracking.",
      "url": "https://mathpracticeonline.com/arithmetic-speed-drill",
      "teaches": "Arithmetic Fluency",
      "provider": { "@id": ORGANIZATION_ID }
    })} />
  </Fragment>

  <h1 slot="h1" class="text-xl sm:text-2xl font-bold text-[#1E293B] leading-tight">Arithmetic Speed Drill</h1>

  <SpeedDrillSetup slot="widget" client:load />

  <Fragment slot="quick-answer">
    <p>Your score is the number of problems you answer correctly before time runs out.</p>
  </Fragment>

  <div slot="how-it-works" class="mt-12 space-y-10">
    <!-- How it works -->
    <section aria-labelledby="hiw-heading">
      <h2 id="hiw-heading" class="text-lg font-semibold text-[#1E293B] mb-3">How the Arithmetic Speed Drill Works</h2>
      <p class="text-sm text-body leading-relaxed">
        Choose one or more operations, then answer as many arithmetic facts as you can in 60 seconds. Addition and subtraction use numbers 1–12, while multiplication covers facts through 12 × 12 with matching division facts. Mix operations or drill just one.
      </p>
    </section>

    <!-- Tips -->
    <section aria-labelledby="tips-heading">
      <h2 id="tips-heading" class="text-lg font-semibold text-[#1E293B] mb-3">How to Improve Your Score</h2>
      <div class="text-sm text-body leading-relaxed space-y-3">
        <p>
          <strong>Start with your weakest operation.</strong> Deselect the others and drill it alone for a session — targeted practice on the operation that slows you down is the fastest path to a higher score.
        </p>
        <p>
          <strong>Build accuracy before speed.</strong> Wrong answers don't add to your score, so a calm, accurate pace beats frantic guessing. If facts still feel effortful, spend time on untimed practice — <a href="/multiplication/facts/" class="text-[#4F46E5] font-medium hover:underline">multiplication facts</a> or <a href="/division/facts/" class="text-[#4F46E5] font-medium hover:underline">division facts</a> — before pushing for speed.
        </p>
        <p>
          <strong>Repeat and compare.</strong> Run the drill again periodically and check your result against your own Personal Best rather than a fixed target — everyone starts from a different baseline.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-lg font-semibold text-[#1E293B] mb-4">Frequently Asked Questions</h2>
      <div class="flex flex-col gap-4">
        {faqItems.map(({ q, a }) => (
          <div class="bg-white border border-[#E2E8F0] rounded-xl px-5 py-4">
            <h3 class="text-sm font-semibold text-[#1E293B] mb-1.5">{q}</h3>
            <p class="text-sm text-body leading-relaxed">{a}</p>
          </div>
        ))}
      </div>
    </section>

    <InternalLinks links={links} />
  </div>
</PracticeLayout>
