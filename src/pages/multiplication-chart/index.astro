---
import PracticeLayout from '@/layouts/PracticeLayout.astro';
import MultiplicationChart from '@/components/MultiplicationChart';
import InternalLinks from '@/components/InternalLinks';
import { ORGANIZATION_ID } from '@/config/site';

const SITE = 'https://mathpracticeonline.com';

const relatedLinks = [
  { href: '/multiplication/times-tables/', label: 'Times Tables', description: 'Practice one multiplication table at a time' },
  { href: '/multiplication/facts/', label: 'Multiplication Facts', description: 'All 144 facts from 1×1 to 12×12 in random order' },
  { href: '/create/', label: 'Create Classroom Practice', description: 'Build a custom practice set to share with students' },
  { href: '/division/divide-by/', label: 'Divide By Practice', description: 'The inverse operation — divisor-by-divisor drills' },
];

const faqItems = [
  {
    q: 'What is a multiplication chart used for?',
    a: 'A multiplication chart shows the product of every pair of numbers from 1 to 12 at a glance. It helps students look up facts they haven’t memorized yet, spot patterns like doubling and skip counting, and check their work during practice.',
  },
  {
    q: 'How do I read a multiplication chart?',
    a: 'Find one factor along the top row and the other factor down the left column. Trace across and down until the two meet — that cell is their product. For example, the row for 7 and the column for 8 meet at 56, so 7 × 8 = 56.',
  },
  {
    q: 'What is the fastest way to learn multiplication facts with a chart?',
    a: 'Use the chart to look up unfamiliar facts while practicing, rather than memorizing it top to bottom. Highlighting a row or column at a time helps you notice patterns — like the 5s always ending in 0 or 5 — which makes recall faster than rote repetition.',
  },
  {
    q: 'Is there a blank multiplication chart for practice?',
    a: 'Yes. Switch to Blank Chart above to hide every product while keeping the row and column headers visible. Use it to quiz yourself on screen, or print it as a fill-in worksheet to complete by hand — there are no typing boxes in the chart itself.',
  },
  {
    q: 'Can I print this multiplication chart in black and white?',
    a: 'Yes. Printing produces a single clean page with just the chart — no menus or webpage text — in black and white with clear cell borders and bold headers. Switch to Blank Chart first if you want a fill-in worksheet instead of a reference sheet.',
  },
  {
    q: 'What is the difference between a multiplication chart and a times table?',
    a: 'A times table lists the multiples of a single number (like the 7 times table: 7, 14, 21…). A multiplication chart combines all twelve times tables into one 12×12 grid, so you can look up any fact from 1×1 to 12×12 in one place.',
  },
];
---

<PracticeLayout
  title="Multiplication Chart 1–12 — Free Interactive & Printable | Math Practice Online"
  description="Free interactive multiplication chart from 1 to 12. Highlight rows and columns, switch to a blank fill-in version, and print a clean black-and-white times table chart."
  canonical={`${SITE}/multiplication-chart`}
  breadcrumb={[
    { label: 'Home', href: '/' },
    { label: 'Multiplication', href: '/multiplication/' },
    { label: 'Multiplication Chart' },
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LearningResource",
      "name": "Multiplication Chart 1–12",
      "description": "A free interactive and printable multiplication chart covering every product from 1×1 through 12×12, with row/column highlighting and a blank fill-in mode.",
      "url": `${SITE}/multiplication-chart`,
      "educationalLevel": ["Grade 2", "Grade 3", "Grade 4"],
      "teaches": "Multiplication facts and products from 1×1 to 12×12",
      "provider": { "@id": ORGANIZATION_ID }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(({ q, a }) => ({
        "@type": "Question",
        "name": q,
        "acceptedAnswer": { "@type": "Answer", "text": a }
      }))
    })} />
  </Fragment>

  <div slot="h1" class="no-print">
    <h1 class="text-3xl font-bold text-[#1E293B]">Multiplication Chart (1–12)</h1>
  </div>

  <div slot="intro" class="no-print">
    <p>A multiplication chart shows the product of every pair of numbers from 1 to 12 in one 12×12 grid. Find a factor along the top row and another down the left column — the cell where they meet is their product. Use the interactive chart below to highlight rows and columns, switch to Blank Chart to quiz yourself on screen or print a fill-in worksheet, or print the filled chart for your desk or classroom.</p>
  </div>

  <div slot="widget">
    <MultiplicationChart client:load />
  </div>

  <div slot="how-it-works" class="no-print">
    <section aria-labelledby="how-to-use-heading" class="mt-10 max-w-xl">
      <h2 id="how-to-use-heading" class="text-lg font-semibold text-[#1E293B] mb-3">How to Use This Multiplication Chart</h2>
      <p class="text-sm text-body leading-relaxed">Click, tap, or use the arrow keys to move around the chart — the matching row, column, and product highlight together so you can see the fact in context. Click a row or column number to highlight that whole times table at once. Switch to Blank Chart to quiz yourself on screen or print it as a fill-in worksheet, and print either version straight from this page.</p>
    </section>

    <section class="mt-10">
      <InternalLinks title="Related Practice" links={relatedLinks} />
    </section>

    <section class="mt-10" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-lg font-semibold text-[#1E293B] mb-4">Frequently Asked Questions</h2>
      <div class="flex flex-col gap-4">
        {faqItems.map(({ q, a }) => (
          <div class="bg-white border border-[#E2E8F0] rounded-xl px-5 py-4">
            <h3 class="text-sm font-semibold text-[#1E293B] mb-1.5">{q}</h3>
            <p class="text-sm text-body leading-relaxed">{a}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</PracticeLayout>

<style is:global>
  /*
   * Page-local print override: the chart needs landscape width for its 13
   * columns. This only affects printing of this document (each Astro page
   * is its own HTML file) — it does not change global.css's portrait @page
   * rule used by the worksheet generator on other pages.
   */
  @page {
    size: landscape;
    margin: 10mm;
  }

  @media print {
    html {
      background: white !important;
    }

    .multiplication-chart-scroll {
      overflow: visible !important;
      border-color: #000 !important;
      page-break-inside: avoid !important;
      break-inside: avoid !important;
    }

    .multiplication-chart-scroll table {
      width: 100% !important;
    }

    .multiplication-chart-scroll th,
    .multiplication-chart-scroll td {
      border-color: #000 !important;
    }
  }
</style>
