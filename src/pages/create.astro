---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import CreatePracticeBuilder from '@/components/CreatePracticeBuilder';
import InternalLinks from '@/components/InternalLinks';
import { SITE_URL } from '@/config/site';
import { PRACTICE_CATEGORY_IDS, PRACTICE_TYPE_REGISTRY, type PracticeCategoryId } from '@/engine/practiceTypes';

const CATEGORY_NAMES: Record<PracticeCategoryId, string> = { addition: 'Addition', subtraction: 'Subtraction', multiplication: 'Multiplication', division: 'Division' };
const CATEGORY_HREFS: Record<PracticeCategoryId, string> = { addition: '/addition/', subtraction: '/subtraction/', multiplication: '/multiplication/', division: '/division/' };

const links = [
  { href: '/addition/', label: 'Addition Practice', description: 'Timed and untimed addition drills' },
  { href: '/subtraction/', label: 'Subtraction Practice', description: 'Timed and untimed subtraction drills' },
  { href: '/multiplication/', label: 'Multiplication Practice', description: 'Facts, times tables, and more' },
  { href: '/division/', label: 'Division Practice', description: 'Facts and division with remainders' },
  { href: '/math-worksheets/', label: 'Math Worksheets', description: 'Printable practice sheets' },
  { href: '/for-teachers/', label: 'For Teachers', description: 'How teachers use this site' },
];

const faqItems = [
  {
    q: 'Do students need an account?',
    a: 'No. A student can open the practice link and begin immediately.',
  },
  {
    q: 'Can I choose specific multiplication facts?',
    a: 'Yes. You can choose any combination of multiplication facts from 1 through 12.',
  },
  {
    q: 'Can I set a timer or number of problems?',
    a: 'Yes. Practice can be untimed or timed, and you can choose a problem limit.',
  },
  {
    q: 'Can I use the same link with multiple students?',
    a: "Yes. The link stores the practice settings, so multiple students can open it — each student's questions are generated fresh, so the exact problems may differ.",
  },
  {
    q: 'Does MathPracticeOnline track student results for teachers?',
    a: 'No. The current creator does not use teacher accounts, rosters, or reporting dashboards.',
  },
];
---
<BaseLayout title="Create Custom Math Practice | Math Practice Online" description="Create custom math practice, choose the skill, number of problems, and timer, then share one link. No teacher or student account required." canonical={`${SITE_URL}/create/`}>
  <SiteHeader />
  <main class="px-4 py-10 sm:px-6 sm:py-14">
    <div class="mx-auto max-w-3xl">
      <header class="mb-8 text-center">
        <h1 class="text-3xl font-extrabold tracking-tight text-[#1E293B] sm:text-4xl">Create Custom Math Practice</h1>
        <p class="mx-auto mt-3 max-w-2xl text-base leading-relaxed text-[#334155] sm:text-lg">Choose a skill, set the number of problems or timer, and copy a link students can open immediately. No sign-up required.</p>
      </header>

      <CreatePracticeBuilder client:load />

      <div class="mt-14 space-y-12">
        <section aria-labelledby="no-account-heading">
          <h2 id="no-account-heading" class="text-xl font-bold text-[#1E293B] mb-3">Create Math Practice Without an Account</h2>
          <p class="text-base text-body leading-relaxed">Create custom math practice for students without setting up teacher or student accounts. Choose the skill, set a problem limit or timer, and copy a link that opens directly into practice—no roster or classroom setup required.</p>
        </section>

        <section aria-labelledby="what-heading">
          <h2 id="what-heading" class="text-xl font-bold text-[#1E293B] mb-4">What Can I Create?</h2>
          <div class="grid gap-5 sm:grid-cols-2">
            {PRACTICE_CATEGORY_IDS.map((category) => (
              <div class="bg-white border border-[#E2E8F0] rounded-xl p-4">
                <h3 class="text-base font-semibold text-[#1E293B] mb-2">
                  <a href={CATEGORY_HREFS[category]} class="hover:text-[#4F46E5] hover:underline">{CATEGORY_NAMES[category]}</a>
                </h3>
                <ul class="space-y-1 text-base text-body leading-relaxed">
                  {PRACTICE_TYPE_REGISTRY.filter((entry) => entry.category === category).map((entry) => (
                    <li>{entry.displayName}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <section aria-labelledby="faq-heading">
          <h2 id="faq-heading" class="text-xl font-bold text-[#1E293B] mb-4">Frequently Asked Questions</h2>
          <div class="flex flex-col gap-4">
            {faqItems.map(({ q, a }) => (
              <div class="bg-white border border-[#E2E8F0] rounded-xl px-5 py-4">
                <h3 class="text-base font-semibold text-[#1E293B] mb-1.5">{q}</h3>
                <p class="text-base text-body leading-relaxed">{a}</p>
              </div>
            ))}
          </div>
        </section>
        <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": faqItems.map(({ q, a }) => ({
            "@type": "Question",
            "name": q,
            "acceptedAnswer": { "@type": "Answer", "text": a }
          }))
        })} />

        <InternalLinks links={links} />
      </div>
    </div>
  </main>
</BaseLayout>
