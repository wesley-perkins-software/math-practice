---
import PracticeLayout from '@/layouts/PracticeLayout.astro';
import SubtractionPracticeHub from '@/components/SubtractionPracticeHub';
import InternalLinks from '@/components/InternalLinks';
import { ORGANIZATION_ID } from '@/config/site';
import '@/styles/practice-surface-prototype.css';

const SITE = 'https://mathpracticeonline.com';

const links = [
  { href: '/subtraction', label: 'All Subtraction Levels', description: 'Choose a difficulty or compare all levels' },
  { href: '/subtraction/2-digit-no-borrowing', label: '2-Digit Subtraction (No Borrowing)', description: 'Next step: two-digit problems without regrouping' },
  { href: '/subtraction/2-digit-with-borrowing', label: '2-Digit Subtraction with Borrowing', description: 'Practice regrouping and borrowing' },
  { href: '/addition/1-digit', label: '1-Digit Addition', description: 'Build inverse-operation fluency' },
  { href: '/math-worksheets/subtraction-worksheets', label: 'Subtraction Worksheets', description: 'Worksheet-style practice with instant feedback' },
];

const faqItems = [
  {
    q: 'What is 1-digit subtraction?',
    a: '1-digit subtraction means finding the difference between two numbers from 0–9, such as 9 − 4 = 5 or 8 − 3 = 5. There are 72 core subtraction facts (2−1 through 9−9, excluding subtracting 0), or 81 if you include differences of zero, and most curricula focus on the facts with differences from 0 to 8.'
  },
  {
    q: 'What grade is 1-digit subtraction?',
    a: '1-digit subtraction is a core Kindergarten and Grade 1 skill. Students work toward fluency with these facts before moving on to two-digit subtraction.'
  },
  {
    q: 'What does "difference" mean in subtraction?',
    a: 'The difference is the result of a subtraction problem. For 7 − 2 = 5, the difference is 5. It represents how much larger one number is than another, or how much is left after taking away.'
  },
  {
    q: 'How do I get faster at single-digit subtraction?',
    a: 'The most effective strategies are: count back from the larger number (for 9 − 3, start at 9 and count back 3), use the "think addition" strategy (for 8 − 5, ask "5 + ? = 8"), and learn fact families (knowing 6 + 4 = 10 means you also know 10 − 4 = 6). Daily short practice sessions build speed faster than occasional long sessions.'
  },
];
---

<PracticeLayout
  title="1-Digit Subtraction Practice | Math Practice Online"
  description="Practice 1-digit subtraction facts online with instant feedback, streak tracking, and timed drills. Build early elementary subtraction fluency and confidence."
  canonical={`${SITE}/subtraction/1-digit`}
  pilotLayout
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Subtraction', href: '/subtraction' }, { label: '1-Digit Subtraction' }]}
  breadcrumbVisual={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LearningResource",
      "name": "1-Digit Subtraction Practice",
      "description": "Interactive online practice for single-digit subtraction facts. Covers all differences from 1−1 through 9−9 with instant feedback and progress tracking.",
      "url": `${SITE}/subtraction/1-digit`,
      "educationalLevel": ["Kindergarten", "Grade 1"],
      "teaches": "Single-digit subtraction",
      "provider": { "@id": ORGANIZATION_ID }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(({ q, a }) => ({
        "@type": "Question",
        "name": q,
        "acceptedAnswer": { "@type": "Answer", "text": a }
      }))
    })} />
  </Fragment>

  <Fragment slot="h1">
    <div class="flex items-center justify-between flex-wrap gap-x-3 gap-y-1">
      <h1 class="text-xl sm:text-2xl font-bold text-[#1E293B] leading-tight">1-Digit Subtraction Practice</h1>
      <nav aria-label="Change practice" class="font-practice">
        <details class="relative" data-dismissable-menu>
          <summary class="list-none flex items-center gap-1 text-base font-semibold text-[#4F46E5] cursor-pointer select-none px-2 py-1 -mr-2 rounded-lg hover:bg-[#F5F3FF] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#4F46E5] focus-visible:ring-offset-1">
            Change practice
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          </summary>
          <div class="absolute right-0 top-full mt-1.5 z-20 w-56 max-w-[calc(100vw-2rem)] bg-white border border-[#E4E1F5] rounded-xl shadow-[0_8px_24px_rgba(79,70,229,0.16)] py-1.5">
            <a href="/subtraction/1-digit" aria-current="page" class="block px-3.5 py-2 text-sm font-semibold text-[#4F46E5] bg-[#F5F3FF]">1-Digit Subtraction</a>
            <a href="/subtraction/2-digit-no-borrowing" class="block px-3.5 py-2 text-sm text-[#43405C] hover:bg-[#FAF9FE]">2-Digit Subtraction (No Borrowing)</a>
            <a href="/subtraction/2-digit-with-borrowing" class="block px-3.5 py-2 text-sm text-[#43405C] hover:bg-[#FAF9FE]">2-Digit Subtraction (Borrowing)</a>
          </div>
        </details>
      </nav>
    </div>
    <script>
      // Same dismissable-menu behavior as the /addition/1-digit prototype's
      // H1-row switcher: closes on Escape (returning focus to the summary),
      // on an outside click, and the moment the user resumes practice
      // (focuses the answer, types, or taps the on-screen keypad) via the
      // `[data-practice-instrument]` marker the practice widget renders
      // itself. See addition/1-digit.astro for the full rationale.
      document.querySelectorAll<HTMLDetailsElement>('details[data-dismissable-menu]').forEach((details) => {
        const summary = details.querySelector('summary');
        const menu = details.querySelector<HTMLElement>(':scope > div');
        const close = () => { details.open = false; };

        const EDGE_MARGIN = 16;
        function clampMenuPosition() {
          if (!menu) return;
          menu.style.left = '';
          menu.style.right = '';
          const rect = menu.getBoundingClientRect();
          const viewportWidth = document.documentElement.clientWidth;
          if (rect.right > viewportWidth - EDGE_MARGIN) {
            menu.style.right = `${Math.max(0, rect.right - (viewportWidth - EDGE_MARGIN))}px`;
          } else if (rect.left < EDGE_MARGIN) {
            const detailsRect = details.getBoundingClientRect();
            menu.style.right = 'auto';
            menu.style.left = `${EDGE_MARGIN - detailsRect.left}px`;
          }
        }
        details.addEventListener('toggle', () => {
          if (details.open) clampMenuPosition();
        });
        window.addEventListener('resize', () => {
          if (details.open) clampMenuPosition();
        });

        document.addEventListener('click', (e) => {
          if (details.open && e.target instanceof Node && !details.contains(e.target)) {
            close();
          }
        });
        details.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && details.open) {
            e.preventDefault();
            close();
            summary?.focus();
          }
        });
        document.querySelectorAll<HTMLElement>('[data-practice-instrument]').forEach((instrument) => {
          instrument.addEventListener('pointerdown', () => { if (details.open) close(); });
          instrument.addEventListener('focusin', () => { if (details.open) close(); });
        });
      });
    </script>
  </Fragment>

  <Fragment slot="quick-answer">
    <p>1-digit subtraction finds the difference between two numbers from 0–9, such as 6 − 2 = 4. Mastering all single-digit subtraction facts is the foundation for two-digit subtraction, borrowing, and quick mental math.</p>
  </Fragment>

  <SubtractionPracticeHub slot="widget" active="1-digit" variant="prototype" client:load />

  <Fragment slot="intro">
    <p>This page is for kindergartners and first graders building single-digit subtraction fluency, as well as parents and teachers checking recall speed. Problems are drawn from single-digit facts with differences from 0 to 8, including take-away and comparison-style subtraction, so students see both meanings of subtraction rather than only counting down.</p>
  </Fragment>

  <div slot="how-it-works" class="mt-12 space-y-8">
    <!-- Grade context -->
    <div class="flex items-center gap-2">
      <span class="text-xs font-semibold text-[#6366F1] bg-[#EEF2FF] px-3 py-1 rounded-full uppercase tracking-wide">Best for: Kindergarten – Grade 1</span>
    </div>

    <!-- What you'll practice -->
    <section aria-labelledby="what-heading">
      <h2 id="what-heading" class="text-lg font-semibold text-[#1E293B] mb-3">What You'll Practice</h2>
      <ul class="space-y-2 text-sm text-[#4B5563] leading-relaxed">
        <li class="flex items-start gap-2"><span class="text-[#4F46E5] font-bold mt-0.5">✓</span> All single-digit subtraction facts (1−1 through 9−1, up to 9−9)</li>
        <li class="flex items-start gap-2"><span class="text-[#4F46E5] font-bold mt-0.5">✓</span> Differences from 0 to 8, including the hardest subtraction facts</li>
        <li class="flex items-start gap-2"><span class="text-[#4F46E5] font-bold mt-0.5">✓</span> Instant feedback on every answer with streak tracking</li>
        <li class="flex items-start gap-2"><span class="text-[#4F46E5] font-bold mt-0.5">✓</span> Streak and best score saved automatically in your browser</li>
      </ul>
    </section>

    <!-- Strategies -->
    <section aria-labelledby="strategies-heading">
      <h2 id="strategies-heading" class="text-lg font-semibold text-[#1E293B] mb-3">Mental Math Strategies</h2>
      <div class="grid gap-3 sm:grid-cols-3">
        <div class="bg-white border border-[#E2E8F0] rounded-xl p-4">
          <h3 class="text-sm font-semibold text-[#1E293B] mb-1">Count Back</h3>
          <p class="text-sm text-[#6B7280] leading-relaxed">Start from the larger number and count down. For 9 − 3: start at 9, count back 3 → 8, 7, 6.</p>
        </div>
        <div class="bg-white border border-[#E2E8F0] rounded-xl p-4">
          <h3 class="text-sm font-semibold text-[#1E293B] mb-1">Think Addition</h3>
          <p class="text-sm text-[#6B7280] leading-relaxed">For 8 − 5: ask "5 + ? = 8." If you know your addition facts, you can find subtraction answers instantly.</p>
        </div>
        <div class="bg-white border border-[#E2E8F0] rounded-xl p-4">
          <h3 class="text-sm font-semibold text-[#1E293B] mb-1">Use Fact Families</h3>
          <p class="text-sm text-[#6B7280] leading-relaxed">Know that 6 + 4 = 10, so 10 − 4 = 6 and 10 − 6 = 4. Addition and subtraction facts come in families of four.</p>
        </div>
      </div>
    </section>

    <!-- Parent & Teacher Guidance -->
    <section aria-labelledby="parent-teacher-heading">
      <h2 id="parent-teacher-heading" class="text-lg font-semibold text-[#1E293B] mb-3">Parent &amp; Teacher Guidance</h2>
      <p class="text-sm text-[#6B7280] leading-relaxed">Subtraction is where "counting" strategies show their limits — a child who's fast at addition often slows down here because counting backward is harder to track than counting forward. Watch for a child who consistently gets an answer one off (like answering 9 − 4 = 4 instead of 5); that's usually a counting error, not a fact-recall error, and it means they're still counting on fingers rather than retrieving the fact. The "think addition" strategy (asking "5 + ? = 9" instead of counting back from 9) is often the fastest fix for a child stuck on counting, since it reuses addition facts they may already know solidly. If a child knows their addition facts well but still struggles here, the gap is usually the connection between the two operations, not weak number sense.</p>
    </section>

    <!-- FAQ -->
    <section aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-lg font-semibold text-[#1E293B] mb-4">Frequently Asked Questions</h2>
      <div class="flex flex-col gap-4">
        {faqItems.map(({ q, a }) => (
          <div class="bg-white border border-[#E2E8F0] rounded-xl px-5 py-4">
            <h3 class="text-sm font-semibold text-[#1E293B] mb-1.5">{q}</h3>
            <p class="text-sm text-[#6B7280] leading-relaxed">{a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Next step -->
    <p class="text-sm text-[#4B5563]">Once these facts feel automatic, move on to <a href="/subtraction/2-digit-no-borrowing" class="text-[#4F46E5] font-semibold hover:underline">two-digit subtraction without borrowing</a> →</p>

    <!-- Internal Links -->
    <InternalLinks links={links} />
  </div>
</PracticeLayout>
