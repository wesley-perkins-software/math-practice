---
import PracticeLayout from '@/layouts/PracticeLayout.astro';
import AdditionPracticeHub from '@/components/AdditionPracticeHub';
import InternalLinks from '@/components/InternalLinks';
import { ORGANIZATION_ID } from '@/config/site';
import '@/styles/practice-surface-prototype.css';

const SITE = 'https://mathpracticeonline.com';

const links = [
  { href: '/addition', label: 'All Addition Levels', description: 'Compare levels or start from the beginning' },
  { href: '/addition/1-digit', label: '1-Digit Addition', description: 'Review single-digit addition fluency first' },
  { href: '/addition/2-digit-with-regrouping', label: '2-Digit Addition With Regrouping', description: 'Next step: add regrouping to the mix' },
  { href: '/subtraction/2-digit-without-regrouping', label: '2-Digit Subtraction (Without Regrouping)', description: 'Pair two-digit addition and subtraction' },
  { href: '/math-worksheets/addition-worksheets', label: 'Addition Worksheets', description: 'Worksheet-style practice with instant feedback' },
];

const faqItems = [
  {
    q: 'What is two-digit addition without regrouping?',
    a: 'Two-digit addition without regrouping means every column adds up to 9 or less, so no digits need to be regrouped (carried). For example, 23 + 45: the ones column is 3 + 5 = 8, and the tens column is 2 + 4 = 6, giving 68. Each column is completely independent.'
  },
  {
    q: 'Why practice addition without regrouping before regrouping?',
    a: 'Learning to align digits by place value and add each column separately is a distinct skill from regrouping. Practicing without-regrouping problems first lets students focus entirely on column alignment and place value without the extra cognitive load of exchanging ones for tens. Once this feels automatic, regrouping is much easier to learn.'
  },
  {
    q: 'What grade is two-digit addition without regrouping?',
    a: 'Two-digit addition without regrouping is typically a late Grade 1 and Grade 2 skill. Students usually master it after achieving fluency with single-digit addition facts.'
  },
  {
    q: 'How is two-digit addition different from single-digit addition?',
    a: 'Two-digit addition requires working with place value. You must align the numbers by their ones and tens columns, then add each column from right to left. Single-digit addition works with one column only, while two-digit addition extends the process to two columns.'
  },
];
---

<PracticeLayout
  title="2-Digit Addition Without Regrouping Practice | Math Practice Online"
  description="Practice 2-digit addition without regrouping. Every problem avoids carrying so students can master place value and multi-digit setup first."
  canonical={`${SITE}/addition/2-digit-without-regrouping`}
  pilotLayout
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Addition', href: '/addition' }, { label: '2-Digit Addition Without Regrouping' }]}
  breadcrumbVisual={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LearningResource",
      "name": "2-Digit Addition Without Regrouping Practice",
      "description": "Interactive online practice for two-digit addition without regrouping. Every problem is designed so no regrouping is needed, isolating the place-value column addition skill.",
      "url": `${SITE}/addition/2-digit-without-regrouping`,
      "educationalLevel": ["Grade 1", "Grade 2"],
      "teaches": "Two-digit addition without regrouping",
      "provider": { "@id": ORGANIZATION_ID }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(({ q, a }) => ({
        "@type": "Question",
        "name": q,
        "acceptedAnswer": { "@type": "Answer", "text": a }
      }))
    })} />
  </Fragment>

  <Fragment slot="h1">
    <div class="flex items-center justify-between flex-wrap gap-x-3 gap-y-1">
      <h1 class="text-xl sm:text-2xl font-bold text-[#1E293B] leading-tight">2-Digit Addition Without Regrouping Practice</h1>
      <nav aria-label="Change practice" class="font-practice">
        <details class="relative" data-dismissable-menu>
          <summary class="list-none flex items-center gap-1 text-base font-semibold text-[#4F46E5] cursor-pointer select-none px-2 py-1 -mr-2 rounded-lg hover:bg-[#F5F3FF] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#4F46E5] focus-visible:ring-offset-1">
            Change practice
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          </summary>
          <div class="absolute right-0 top-full mt-1.5 z-20 w-56 max-w-[calc(100vw-2rem)] bg-white border border-[#E4E1F5] rounded-xl shadow-[0_8px_24px_rgba(79,70,229,0.16)] py-1.5">
            <a href="/addition/1-digit" class="block px-3.5 py-2 text-sm text-[#43405C] hover:bg-[#FAF9FE]">1-Digit Addition</a>
            <a href="/addition/2-digit-without-regrouping" aria-current="page" class="block px-3.5 py-2 text-sm font-semibold text-[#4F46E5] bg-[#F5F3FF]">2-Digit Addition (Without Regrouping)</a>
            <a href="/addition/2-digit-with-regrouping" class="block px-3.5 py-2 text-sm text-[#43405C] hover:bg-[#FAF9FE]">2-Digit Addition (With Regrouping)</a>
          </div>
        </details>
      </nav>
    </div>
    <script>
      // Same dismissable-menu behavior as the /addition/1-digit prototype's
      // H1-row switcher: closes on Escape (returning focus to the summary),
      // on an outside click, and the moment the user resumes practice
      // (focuses the answer, types, or taps the on-screen keypad) via the
      // `[data-practice-instrument]` marker the practice widget renders
      // itself. See addition/1-digit.astro for the full rationale.
      document.querySelectorAll<HTMLDetailsElement>('details[data-dismissable-menu]').forEach((details) => {
        const summary = details.querySelector('summary');
        const menu = details.querySelector<HTMLElement>(':scope > div');
        const close = () => { details.open = false; };

        const EDGE_MARGIN = 16;
        function clampMenuPosition() {
          if (!menu) return;
          menu.style.left = '';
          menu.style.right = '';
          const rect = menu.getBoundingClientRect();
          const viewportWidth = document.documentElement.clientWidth;
          if (rect.right > viewportWidth - EDGE_MARGIN) {
            menu.style.right = `${Math.max(0, rect.right - (viewportWidth - EDGE_MARGIN))}px`;
          } else if (rect.left < EDGE_MARGIN) {
            const detailsRect = details.getBoundingClientRect();
            menu.style.right = 'auto';
            menu.style.left = `${EDGE_MARGIN - detailsRect.left}px`;
          }
        }
        details.addEventListener('toggle', () => {
          if (details.open) clampMenuPosition();
        });
        window.addEventListener('resize', () => {
          if (details.open) clampMenuPosition();
        });

        document.addEventListener('click', (e) => {
          if (details.open && e.target instanceof Node && !details.contains(e.target)) {
            close();
          }
        });
        details.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && details.open) {
            e.preventDefault();
            close();
            summary?.focus();
          }
        });
        document.querySelectorAll<HTMLElement>('[data-practice-instrument]').forEach((instrument) => {
          instrument.addEventListener('pointerdown', () => { if (details.open) close(); });
          instrument.addEventListener('focusin', () => { if (details.open) close(); });
        });
      });
    </script>
  </Fragment>

  <Fragment slot="quick-answer">
    <p>Two-digit addition without regrouping combines two numbers from 10–99 where every column sum stays at 9 or less, such as 31 + 46 = 77. Because no digit ever needs to be regrouped (carried), this is the step where students first practice place-value column addition before regrouping is introduced.</p>
  </Fragment>

  <AdditionPracticeHub slot="widget" active="2-digit-without-regrouping" variant="prototype" client:load />

  <Fragment slot="intro">
    <p>This page is for first and second graders who already know their single-digit addition facts and are learning to add multi-digit numbers for the first time, plus parents and teachers checking whether a child can align columns correctly. Every problem here is built so no column ever sums to 10 or more, isolating place-value alignment from the separate skill of regrouping.</p>
  </Fragment>

  <div slot="how-it-works" class="mt-12 space-y-8">
    <!-- Grade context -->
    <div class="flex items-center gap-2">
      <span class="text-xs font-semibold text-[#6366F1] bg-[#EEF2FF] px-3 py-1 rounded-full uppercase tracking-wide">Best for: Grade 1 – Grade 2</span>
    </div>

    <!-- What you'll practice -->
    <section aria-labelledby="what-heading">
      <h2 id="what-heading" class="text-lg font-semibold text-[#1E293B] mb-3">What You'll Practice</h2>
      <ul class="space-y-2 text-sm text-[#4B5563] leading-relaxed">
        <li class="flex items-start gap-2"><span class="text-[#4F46E5] font-bold mt-0.5">✓</span> Two-digit addition problems (10–99 + 10–99) where no column sums to 10 or more</li>
        <li class="flex items-start gap-2"><span class="text-[#4F46E5] font-bold mt-0.5">✓</span> Aligning tens and ones columns by place value</li>
        <li class="flex items-start gap-2"><span class="text-[#4F46E5] font-bold mt-0.5">✓</span> Adding each column independently from right to left</li>
        <li class="flex items-start gap-2"><span class="text-[#4F46E5] font-bold mt-0.5">✓</span> Instant feedback on every answer with streak and score tracking</li>
      </ul>
    </section>

    <!-- How to solve -->
    <section aria-labelledby="howto-heading">
      <h2 id="howto-heading" class="text-lg font-semibold text-[#1E293B] mb-3">How to Solve Two-Digit Addition</h2>
      <div class="grid gap-3 sm:grid-cols-3">
        <div class="bg-white border border-[#E2E8F0] rounded-xl p-4">
          <div class="text-[#4F46E5] font-bold text-sm mb-1">Step 1</div>
          <h3 class="text-sm font-semibold text-[#1E293B] mb-1">Align by Place Value</h3>
          <p class="text-sm text-[#6B7280] leading-relaxed">Write the numbers so the ones digits are in one column and the tens digits are in another. Alignment prevents place-value errors.</p>
        </div>
        <div class="bg-white border border-[#E2E8F0] rounded-xl p-4">
          <div class="text-[#4F46E5] font-bold text-sm mb-1">Step 2</div>
          <h3 class="text-sm font-semibold text-[#1E293B] mb-1">Add the Ones Column</h3>
          <p class="text-sm text-[#6B7280] leading-relaxed">Start on the right. Add the two ones digits together and write the result below the ones column.</p>
        </div>
        <div class="bg-white border border-[#E2E8F0] rounded-xl p-4">
          <div class="text-[#4F46E5] font-bold text-sm mb-1">Step 3</div>
          <h3 class="text-sm font-semibold text-[#1E293B] mb-1">Add the Tens Column</h3>
          <p class="text-sm text-[#6B7280] leading-relaxed">Move left to the tens column. Add those two digits and write the result. Since there is no regrouping, you're done.</p>
        </div>
      </div>
    </section>

    <!-- Parent & Teacher Guidance -->
    <section aria-labelledby="parent-teacher-heading">
      <h2 id="parent-teacher-heading" class="text-lg font-semibold text-[#1E293B] mb-3">Parent &amp; Teacher Guidance</h2>
      <p class="text-sm text-[#6B7280] leading-relaxed">The skill being tested here isn't addition itself — it's whether a child lines up the ones and tens columns correctly before adding. Watch for a child who solves 23 + 5 by adding 2 + 5 instead of 3 + 5; that's a column-alignment error, not an addition-facts error, and it needs a different fix (grid paper or wider spacing helps more than more practice problems). If a child solves every problem correctly but slowly, they're likely still adding each column one number at a time instead of retrieving facts instantly — that's normal at this stage and will speed up with the single-digit fact practice on the 1-digit page. Because no problem here ever requires regrouping, a child who's ready to move on should be getting these right quickly and consistently before starting the regrouping page.</p>
    </section>

    <!-- FAQ -->
    <section aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-lg font-semibold text-[#1E293B] mb-4">Frequently Asked Questions</h2>
      <div class="flex flex-col gap-4">
        {faqItems.map(({ q, a }) => (
          <div class="bg-white border border-[#E2E8F0] rounded-xl px-5 py-4">
            <h3 class="text-sm font-semibold text-[#1E293B] mb-1.5">{q}</h3>
            <p class="text-sm text-[#6B7280] leading-relaxed">{a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Next step -->
    <p class="text-sm text-[#4B5563]">Ready for regrouping? Try <a href="/addition/2-digit-with-regrouping" class="text-[#4F46E5] font-semibold hover:underline">two-digit addition with regrouping</a> next →</p>

    <!-- Internal Links -->
    <InternalLinks links={links} />
  </div>
</PracticeLayout>
