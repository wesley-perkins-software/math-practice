---
import PracticeLayout from '@/layouts/PracticeLayout.astro';
import DivisionPracticeHub from '@/components/DivisionPracticeHub';
import InternalLinks from '@/components/InternalLinks';
import { ORGANIZATION_ID } from '@/config/site';
import '@/styles/practice-surface-prototype.css';

const SITE = 'https://mathpracticeonline.com';

const links = [
  { href: '/division/facts', label: 'Division Facts Practice', description: 'Exact division fundamentals' },
  { href: '/division/divide-by/1', label: 'Divide by 1 Practice', description: 'Single-divisor focus' },
  { href: '/division/divide-by/12', label: 'Divide by 12 Practice', description: 'Challenge one divisor' },
  { href: '/math-worksheets/division-worksheets', label: 'Division Worksheets', description: 'Printable long division practice' },
  { href: '/arithmetic-speed-drill', label: 'Arithmetic Speed Drill', description: 'Mixed timed arithmetic practice' },
];

const faqItems = [
  {
    q: 'What is a remainder in division?',
    a: 'A remainder is the amount left over when a number cannot be divided into equal groups. For example, 29 ÷ 6 = 4 remainder 5 — six fits into 29 four times (4×6=24) with 5 left over. The remainder is always smaller than the divisor.',
  },
  {
    q: 'What grade level introduces division with remainders?',
    a: 'Division with remainders is typically introduced in late Grade 3 and becomes a core skill in Grade 4. Students should know their multiplication and division facts before working with remainders, since you need fact fluency to quickly determine how many times a divisor fits into a dividend.',
  },
  {
    q: 'How do you find the quotient and remainder?',
    a: 'Determine how many times the divisor fits into the dividend without exceeding it — that is the quotient. Multiply the quotient by the divisor and subtract from the dividend to get the remainder. For 29 ÷ 6: 6 fits 4 times (4×6=24), so quotient = 4 and remainder = 29 − 24 = 5.',
  },
  {
    q: 'What is the difference between exact division and division with remainders?',
    a: 'Exact division (division facts) always produces a whole-number answer with nothing left over — for example, 42÷6=7. Division with remainders produces a quotient plus a leftover amount — for example, 29÷6=4 remainder 5. Real-world division problems often have remainders that carry meaning in context.',
  },
  {
    q: 'How does this practice work?',
    a: 'Each problem asks you to enter both the quotient and the remainder. Instant feedback is shown after each answer — a longer pause on incorrect answers gives you time to reflect. Your streak and scores are saved automatically in your browser.',
  },
];
---

<PracticeLayout
  title="Division with Remainders Practice — Free Online Drills | Math Practice Online"
  description="Practice division with remainders by entering quotient and remainder. Build the understanding needed for long division, Grade 3–4 problem solving, and real-world math."
  canonical={`${SITE}/division/remainders`}
  pilotLayout
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Division', href: '/division' }, { label: 'Remainders' }]}
  breadcrumbVisual={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LearningResource",
      "name": "Division with Remainders Practice",
      "description": "Free online practice for division with remainders. Enter the quotient and remainder for each problem. Builds understanding for long division and Grade 4 problem solving.",
      "url": `${SITE}/division/remainders`,
      "educationalLevel": ["Grade 3", "Grade 4"],
      "teaches": "Division",
      "provider": { "@id": ORGANIZATION_ID }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(({ q, a }) => ({
        "@type": "Question",
        "name": q,
        "acceptedAnswer": { "@type": "Answer", "text": a }
      }))
    })} />
  </Fragment>

  <Fragment slot="h1">
    <div class="flex items-center justify-between flex-wrap gap-x-3 gap-y-1">
      <h1 class="text-xl sm:text-2xl font-bold text-[#1E293B] leading-tight">Division with Remainders Practice</h1>
      <nav aria-label="Change practice" class="font-practice">
        <details class="relative" data-dismissable-menu>
          <summary class="list-none flex items-center gap-1 text-base font-semibold text-[#4F46E5] cursor-pointer select-none px-2 py-1 -mr-2 rounded-lg hover:bg-[#F5F3FF] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#4F46E5] focus-visible:ring-offset-1">
            Change practice
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          </summary>
          <div class="absolute right-0 top-full mt-1.5 z-20 w-56 max-w-[calc(100vw-2rem)] bg-white border border-[#E4E1F5] rounded-xl shadow-[0_8px_24px_rgba(79,70,229,0.16)] py-1.5">
            <a href="/division/divide-by/1" class="block px-3.5 py-2 text-sm text-[#43405C] hover:bg-[#FAF9FE]">Divide By</a>
            <a href="/division/facts" class="block px-3.5 py-2 text-sm text-[#43405C] hover:bg-[#FAF9FE]">Division Facts</a>
            <a href="/division/remainders" aria-current="page" class="block px-3.5 py-2 text-sm font-semibold text-[#4F46E5] bg-[#F5F3FF]">With Remainders</a>
          </div>
        </details>
      </nav>
    </div>
    <script>
      // Same dismissable-menu behavior as the /addition/1-digit prototype's
      // H1-row switcher: closes on Escape (returning focus to the summary),
      // on an outside click, and the moment the user resumes practice
      // (focuses the answer, types, or taps the on-screen keypad) via the
      // `[data-practice-instrument]` marker the practice widget renders
      // itself. See addition/1-digit.astro for the full rationale.
      document.querySelectorAll<HTMLDetailsElement>('details[data-dismissable-menu]').forEach((details) => {
        const summary = details.querySelector('summary');
        const menu = details.querySelector<HTMLElement>(':scope > div');
        const close = () => { details.open = false; };

        const EDGE_MARGIN = 16;
        function clampMenuPosition() {
          if (!menu) return;
          menu.style.left = '';
          menu.style.right = '';
          const rect = menu.getBoundingClientRect();
          const viewportWidth = document.documentElement.clientWidth;
          if (rect.right > viewportWidth - EDGE_MARGIN) {
            menu.style.right = `${Math.max(0, rect.right - (viewportWidth - EDGE_MARGIN))}px`;
          } else if (rect.left < EDGE_MARGIN) {
            const detailsRect = details.getBoundingClientRect();
            menu.style.right = 'auto';
            menu.style.left = `${EDGE_MARGIN - detailsRect.left}px`;
          }
        }
        details.addEventListener('toggle', () => {
          if (details.open) clampMenuPosition();
        });
        window.addEventListener('resize', () => {
          if (details.open) clampMenuPosition();
        });

        document.addEventListener('click', (e) => {
          if (details.open && e.target instanceof Node && !details.contains(e.target)) {
            close();
          }
        });
        details.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && details.open) {
            e.preventDefault();
            close();
            summary?.focus();
          }
        });
        document.querySelectorAll<HTMLElement>('[data-practice-instrument]').forEach((instrument) => {
          instrument.addEventListener('pointerdown', () => { if (details.open) close(); });
          instrument.addEventListener('focusin', () => { if (details.open) close(); });
        });
      });
    </script>
  </Fragment>

  <Fragment slot="quick-answer">
    <p>Division with remainders happens when a number doesn't divide evenly, leaving an amount smaller than the divisor left over, such as 23 ÷ 4 = 5 remainder 3. This page builds the same quotient-plus-remainder skill used in long division.</p>
  </Fragment>

  <DivisionPracticeHub slot="widget" active="remainders" client:load />

  <Fragment slot="intro">
    <p>This page is for third and fourth graders who've mastered exact division facts and are ready to handle numbers that don't divide evenly, as well as parents and teachers checking whether a child understands what a remainder represents, not just how to compute it. Enter both the quotient and remainder for each problem to build the accuracy and conceptual grounding needed for long division and multi-step word problems.</p>
  </Fragment>

  <Fragment slot="how-it-works">
    <section class="mt-12" aria-labelledby="remainders-progression-heading">
      <h2 id="remainders-progression-heading" class="text-lg font-semibold text-[#1E293B] mb-4">Grade-by-Grade Progression</h2>
      <div class="bg-white border border-[#E2E8F0] rounded-2xl overflow-hidden">
        <div class="divide-y divide-[#E2E8F0]">
          <div class="flex items-start gap-4 px-5 py-4">
            <span class="w-20 text-xs font-semibold text-[#6366F1] uppercase tracking-wide pt-0.5 shrink-0">Grade 3</span>
            <div>
              <p class="text-sm font-medium text-[#1E293B]">Introduction to Remainders</p>
              <p class="text-sm text-[#6B7280] mt-0.5">After mastering exact division facts, begin exploring what happens when a number doesn't divide evenly. Build the concept of quotient + remainder as "groups plus leftovers."</p>
            </div>
          </div>
          <div class="flex items-start gap-4 px-5 py-4">
            <span class="w-20 text-xs font-semibold text-[#6366F1] uppercase tracking-wide pt-0.5 shrink-0">Grade 4</span>
            <div>
              <p class="text-sm font-medium text-[#1E293B]">Application to Word Problems</p>
              <p class="text-sm text-[#6B7280] mt-0.5">Interpret remainders in real-world contexts — when do you round up (e.g., how many buses needed?) versus round down (e.g., how many full rows fit?). Apply remainder division to multi-step problems.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 px-5 py-4">
            <span class="w-20 text-xs font-semibold text-[#6366F1] uppercase tracking-wide pt-0.5 shrink-0">Grade 5</span>
            <div>
              <p class="text-sm font-medium text-[#1E293B]">Long Division Foundation</p>
              <p class="text-sm text-[#6B7280] mt-0.5">Remainder understanding is essential for multi-digit long division. Students who can fluently find quotient and remainder for single-digit divisors are well-prepared to extend this to two-digit divisors.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="remainders-tips-heading">
      <h2 id="remainders-tips-heading" class="text-lg font-semibold text-[#1E293B] mb-4">Tips for Parents and Teachers</h2>
      <div class="bg-[#EEF2FF] rounded-2xl px-5 py-5 text-sm text-[#4B5563] leading-relaxed space-y-3">
        <p>
          Make sure <a href="/division/facts" class="text-[#4F46E5] font-medium hover:underline">exact division facts</a> are fluent before introducing remainders. Students who aren't sure whether 54÷6=9 will struggle to figure out where 55÷6 lands — the remainder process requires fact recall as a starting point.
        </p>
        <p>
          Use real-world examples to make remainders concrete: "If 29 students need to form groups of 6, how many full groups form and how many students are left over?" This frames the quotient and remainder as meaningful quantities, not just numbers to write.
        </p>
        <p>
          Once students are confident here, use the <a href="/math-worksheets/division-worksheets" class="text-[#4F46E5] font-medium hover:underline">division with remainders worksheet</a>, which displays problems in the standard long division bracket format — the same notation students use for written work in school.
        </p>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="remainders-faq-heading">
      <h2 id="remainders-faq-heading" class="text-lg font-semibold text-[#1E293B] mb-4">Frequently Asked Questions</h2>
      <div class="flex flex-col gap-4">
        {faqItems.map(({ q, a }) => (
          <div class="bg-white border border-[#E2E8F0] rounded-xl px-5 py-4">
            <h3 class="text-sm font-semibold text-[#1E293B] mb-1.5">{q}</h3>
            <p class="text-sm text-[#6B7280] leading-relaxed">{a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Next step -->
    <p class="mt-12 text-sm text-[#4B5563]">Ready to put it all together? Try the <a href="/arithmetic-speed-drill" class="text-[#4F46E5] font-semibold hover:underline">Arithmetic Speed Drill</a> for mixed, timed practice across every operation →</p>

    <!-- Internal Links -->
    <InternalLinks links={links} />
  </Fragment>
</PracticeLayout>
