---
import PracticeLayout from '@/layouts/PracticeLayout.astro';
import DivisionPracticeHub from '@/components/DivisionPracticeHub';
import InternalLinks from '@/components/InternalLinks';
import { ORGANIZATION_ID } from '@/config/site';
import '@/styles/practice-surface-prototype.css';

const SITE = 'https://mathpracticeonline.com';

const links = [
  { href: '/division/divide-by/1', label: 'Divide by 1 Practice', description: 'Start with the simplest fact family' },
  { href: '/division/divide-by/6', label: 'Divide by 6 Practice', description: 'Target one of the trickier divisors' },
  { href: '/division/remainders', label: 'Division with Remainders', description: 'Quotient plus remainder' },
  { href: '/math-worksheets/division-worksheets', label: 'Division Worksheets', description: 'Printable division practice' },
  { href: '/division', label: 'Division Practice Hub', description: 'All division modes in one place' },
];

const faqItems = [
  {
    q: 'What are division facts?',
    a: 'Division facts are the basic exact division problems from 1÷1 through 144÷12. They are the inverse of multiplication facts — knowing 7×8=56 means you also know 56÷7=8 and 56÷8=7. Mastering all division facts gives students fast, automatic recall for any basic division problem.',
  },
  {
    q: 'What grade level are division facts?',
    a: 'Division facts are typically introduced in Grade 3 alongside multiplication fact families. By the end of Grade 3, students are expected to recall basic division facts fluently. Continued practice in Grade 4 builds the speed needed for multi-step problems and long division work.',
  },
  {
    q: 'How do I help my child learn division facts?',
    a: 'Start by making sure multiplication facts are solid — division fluency follows naturally from multiplication fluency. Practice one divisor at a time using the Divide by N pages, then mix all divisors here for comprehensive practice. Short daily sessions of 5–10 minutes produce faster results than occasional longer sessions.',
  },
  {
    q: 'What is the fastest way to memorize division facts?',
    a: 'The most effective method is connecting division facts to known multiplication facts through fact families. For example: "8×7=56, so 56÷8=7." Practice the specific divisors that feel weakest using the divide-by-N pages, then return to mixed practice here. Consistent short sessions outperform rare long study sessions.',
  },
  {
    q: 'How does this practice work?',
    a: 'Problems appear one at a time with instant right/wrong feedback after every answer. Your streak, personal best score, and session history are saved automatically in your browser. No login or account is required.',
  },
];
---

<PracticeLayout
  title="Division Facts Practice — Free Online Division Drills | Math Practice Online"
  description="Practice basic division facts 1÷1 through 144÷12 with instant feedback. Build speed, accuracy, and confidence with mixed division fact drills. No signup required."
  canonical={`${SITE}/division/facts`}
  pilotLayout
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Division', href: '/division' }, { label: 'Facts' }]}
  breadcrumbVisual={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LearningResource",
      "name": "Division Facts Practice",
      "description": "Free online division facts practice covering all exact division problems from 1÷1 through 144÷12. Instant feedback and progress tracking.",
      "url": `${SITE}/division/facts`,
      "educationalLevel": ["Grade 3", "Grade 4"],
      "teaches": "Division",
      "provider": { "@id": ORGANIZATION_ID }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(({ q, a }) => ({
        "@type": "Question",
        "name": q,
        "acceptedAnswer": { "@type": "Answer", "text": a }
      }))
    })} />
  </Fragment>

  <Fragment slot="h1">
    <div class="flex items-center justify-between flex-wrap gap-x-3 gap-y-1">
      <h1 class="text-xl sm:text-2xl font-bold text-[#1E293B] leading-tight">Division Facts Practice</h1>
      <nav aria-label="Change practice" class="font-practice">
        <details class="relative" data-dismissable-menu>
          <summary class="list-none flex items-center gap-1 text-base font-semibold text-[#4F46E5] cursor-pointer select-none px-2 py-1 -mr-2 rounded-lg hover:bg-[#F5F3FF] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#4F46E5] focus-visible:ring-offset-1">
            Change practice
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          </summary>
          <div class="absolute right-0 top-full mt-1.5 z-20 w-56 max-w-[calc(100vw-2rem)] bg-white border border-[#E4E1F5] rounded-xl shadow-[0_8px_24px_rgba(79,70,229,0.16)] py-1.5">
            <a href="/division/divide-by/1" class="block px-3.5 py-2 text-sm text-[#43405C] hover:bg-[#FAF9FE]">Divide By</a>
            <a href="/division/facts" aria-current="page" class="block px-3.5 py-2 text-sm font-semibold text-[#4F46E5] bg-[#F5F3FF]">Division Facts</a>
            <a href="/division/remainders" class="block px-3.5 py-2 text-sm text-[#43405C] hover:bg-[#FAF9FE]">With Remainders</a>
          </div>
        </details>
      </nav>
    </div>
    <script>
      // Same dismissable-menu behavior as the /addition/1-digit and
      // /division/remainders prototypes' H1-row switcher: closes on Escape
      // (returning focus to the summary), on an outside click, and the
      // moment the user resumes practice (focuses the answer, types, or
      // taps the on-screen keypad) via the `[data-practice-instrument]`
      // marker the practice widget renders itself. See addition/1-digit.astro
      // for the full rationale.
      document.querySelectorAll<HTMLDetailsElement>('details[data-dismissable-menu]').forEach((details) => {
        const summary = details.querySelector('summary');
        const menu = details.querySelector<HTMLElement>(':scope > div');
        const close = () => { details.open = false; };

        const EDGE_MARGIN = 16;
        function clampMenuPosition() {
          if (!menu) return;
          menu.style.left = '';
          menu.style.right = '';
          const rect = menu.getBoundingClientRect();
          const viewportWidth = document.documentElement.clientWidth;
          if (rect.right > viewportWidth - EDGE_MARGIN) {
            menu.style.right = `${Math.max(0, rect.right - (viewportWidth - EDGE_MARGIN))}px`;
          } else if (rect.left < EDGE_MARGIN) {
            const detailsRect = details.getBoundingClientRect();
            menu.style.right = 'auto';
            menu.style.left = `${EDGE_MARGIN - detailsRect.left}px`;
          }
        }
        details.addEventListener('toggle', () => {
          if (details.open) clampMenuPosition();
        });
        window.addEventListener('resize', () => {
          if (details.open) clampMenuPosition();
        });

        document.addEventListener('click', (e) => {
          if (details.open && e.target instanceof Node && !details.contains(e.target)) {
            close();
          }
        });
        details.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && details.open) {
            e.preventDefault();
            close();
            summary?.focus();
          }
        });
        document.querySelectorAll<HTMLElement>('[data-practice-instrument]').forEach((instrument) => {
          instrument.addEventListener('pointerdown', () => { if (details.open) close(); });
          instrument.addEventListener('focusin', () => { if (details.open) close(); });
        });
      });
    </script>
  </Fragment>

  <Fragment slot="intro">
    <div class="mb-4 bg-[#F8FAFC] border border-[#E2E8F0] rounded-xl px-4 py-3 text-[#1E293B] text-sm sm:text-base leading-relaxed">
      <p>Division facts are the exact division problems from 1÷1 through 144÷12, such as 42 ÷ 6 = 7. Every division fact is the inverse of a multiplication fact, so fluency here depends directly on multiplication fact recall.</p>
    </div>
    <p>This page is for third and fourth graders who already know their multiplication facts and are building matching division fluency, as well as parents and teachers checking recall speed rather than conceptual understanding. Practice mixed exact division problems across all facts 1÷1 through 144÷12 — every problem divides evenly, reinforcing core facts and recall speed as a foundation for long division.</p>
  </Fragment>

  <DivisionPracticeHub slot="widget" active="facts" client:load />

  <Fragment slot="how-it-works">
    <section class="mt-12" aria-labelledby="facts-progression-heading">
      <h2 id="facts-progression-heading" class="text-lg font-semibold text-[#1E293B] mb-4">Grade-by-Grade Progression</h2>
      <div class="bg-white border border-[#E2E8F0] rounded-2xl overflow-hidden">
        <div class="divide-y divide-[#E2E8F0]">
          <div class="flex items-start gap-4 px-5 py-4">
            <span class="w-20 text-xs font-semibold text-[#6366F1] uppercase tracking-wide pt-0.5 shrink-0">Grade 3</span>
            <div>
              <p class="text-sm font-medium text-[#1E293B]">Division Facts and Fact Families</p>
              <p class="text-sm text-[#6B7280] mt-0.5">Learn division as equal sharing and grouping. Build fluency with all exact facts and connect each fact to its multiplication partner (e.g., 56÷7=8 because 7×8=56).</p>
            </div>
          </div>
          <div class="flex items-start gap-4 px-5 py-4">
            <span class="w-20 text-xs font-semibold text-[#6366F1] uppercase tracking-wide pt-0.5 shrink-0">Grade 4</span>
            <div>
              <p class="text-sm font-medium text-[#1E293B]">Speed and Application</p>
              <p class="text-sm text-[#6B7280] mt-0.5">Increase recall speed for use in multi-step problems, long division, and real-world contexts. Strong fact fluency makes every other division skill faster to learn.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 px-5 py-4">
            <span class="w-20 text-xs font-semibold text-[#6366F1] uppercase tracking-wide pt-0.5 shrink-0">Grade 5</span>
            <div>
              <p class="text-sm font-medium text-[#1E293B]">Long Division Foundation</p>
              <p class="text-sm text-[#6B7280] mt-0.5">Automatic fact recall is the key input for multi-digit long division. Students who hesitate on basic facts spend extra mental effort on each step of long division, slowing the whole process down.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="facts-tips-heading">
      <h2 id="facts-tips-heading" class="text-lg font-semibold text-[#1E293B] mb-4">Tips for Parents and Teachers</h2>
      <div class="bg-[#EEF2FF] rounded-2xl px-5 py-5 text-sm text-[#4B5563] leading-relaxed space-y-3">
        <p>
          Practice one divisor at a time if students feel overwhelmed by mixed facts. Use <a href="/division/divide-by/2" class="text-[#4F46E5] font-medium hover:underline">divide by 2</a>, <a href="/division/divide-by/5" class="text-[#4F46E5] font-medium hover:underline">divide by 5</a>, and <a href="/division/divide-by/10" class="text-[#4F46E5] font-medium hover:underline">divide by 10</a> first — these tend to click quickly and build early confidence.
        </p>
        <p>
          Reinforce the connection between multiplication and division. For every multiplication fact students know, they also know two division facts. Point this out explicitly: "If 6×9=54, that gives us both 54÷6=9 and 54÷9=6."
        </p>
        <p>
          Once facts feel fluent here, move to <a href="/division/remainders" class="text-[#4F46E5] font-medium hover:underline">division with remainders</a> to extend understanding to non-exact division. Print a <a href="/math-worksheets/division-worksheets" class="text-[#4F46E5] font-medium hover:underline">division worksheet</a> for offline practice between sessions.
        </p>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="facts-faq-heading">
      <h2 id="facts-faq-heading" class="text-lg font-semibold text-[#1E293B] mb-4">Frequently Asked Questions</h2>
      <div class="flex flex-col gap-4">
        {faqItems.map(({ q, a }) => (
          <div class="bg-white border border-[#E2E8F0] rounded-xl px-5 py-4">
            <h3 class="text-sm font-semibold text-[#1E293B] mb-1.5">{q}</h3>
            <p class="text-sm text-[#6B7280] leading-relaxed">{a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Next step -->
    <p class="mt-12 text-sm text-[#4B5563]">Comfortable with exact division? Try <a href="/division/remainders" class="text-[#4F46E5] font-semibold hover:underline">division with remainders</a> next →</p>

    <!-- Internal Links -->
    <InternalLinks links={links} />
  </Fragment>
</PracticeLayout>
