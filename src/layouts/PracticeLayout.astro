---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  breadcrumb?: BreadcrumbItem[];
  /**
   * Pilot-only: puts a short "quick-answer" slot above the widget and moves the
   * expanded "intro" slot below it (practice-first order). Defaults to false so
   * the 27 non-pilot pages keep today's order (intro above widget) unchanged
   * until the pilot is validated — see docs/seo/CANONICAL_LEAF_PAGE_STANDARD.md.
   */
  pilotLayout?: boolean;
  /**
   * Defaults to true so every existing page's visible breadcrumb is unchanged.
   * When false, the breadcrumb `<nav>` is not rendered — but the BreadcrumbList
   * JSON-LD above is unconditional on `breadcrumb.length`, not on this flag, so
   * structured data/SEO is unaffected either way. Currently only set false by
   * the /addition/1-digit practice-surface prototype, which found the visible
   * breadcrumb redundant with the H1 + global nav on a repeated-use utility page.
   */
  breadcrumbVisual?: boolean;
}

const { title, description, canonical, breadcrumb = [], pilotLayout = false, breadcrumbVisual = true } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    {breadcrumb.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumb.map((item, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": item.label,
          ...(item.href ? { "item": `https://mathpracticeonline.com${item.href}` } : {})
        }))
      })} />
    )}
    <slot name="head" />
  </Fragment>
  <!-- Site Header -->
  <SiteHeader paddingY="py-2.5" />

  <!--
    Page-level ad-rail shell: inert at ordinary widths (laptop/tablet/mobile all
    collapse to a single centered column). Only at genuine surplus width does the
    grid have side columns to give — no ad code or placeholders live here, this is
    structure only, sized so a future rail child can be added without reflowing
    the central column. Wraps the whole content column, not just the widget.
  -->
  <div class="w-full 2xl:grid 2xl:grid-cols-[1fr_minmax(0,56rem)_1fr] 2xl:items-start">
    <aside class="hidden 2xl:block" aria-hidden="true"></aside>

    <main class={`max-w-3xl mx-auto px-4 sm:px-6 w-full ${pilotLayout ? 'pt-3 sm:pt-4 pb-10 [@media(pointer:coarse)_and_(min-width:640px)_and_(max-width:1366px)_and_(max-height:850px)]:pt-1' : 'py-8'}`}>
      <!-- Breadcrumb -->
      {breadcrumb.length > 0 && breadcrumbVisual && (
        <nav aria-label="Breadcrumb" class={`text-sm text-[#6B7280] flex items-center flex-wrap gap-1 ${pilotLayout ? 'mb-2' : 'mb-4'}`}>
          {breadcrumb.map((item, i) => (
            <>
              {i > 0 && <span aria-hidden="true" class="text-[#C7D2FE]/40">›</span>}
              {item.href ? (
                <a href={item.href} class="hover:text-[#4F46E5] transition-colors">{item.label}</a>
              ) : (
                <span class="text-[#6B7280]">{item.label}</span>
              )}
            </>
          ))}
        </nav>
      )}

      <!-- H1 -->
      <slot name="h1" />

      {pilotLayout ? (
        <>
          <!-- Practice Widget: immediately after the H1, nothing competing above it -->
          <div class="mt-3 [@media(pointer:coarse)_and_(min-width:640px)_and_(max-width:1366px)_and_(max-height:850px)]:mt-1.5">
            <slot name="widget" />
          </div>

          <!--
            Future ad seam: on mobile/tablet, an ad will eventually be
            inserted here, between the widget and the local chooser. The
            local chooser below is already its own section (not nested
            inside the widget's div above), so that insertion won't require
            any DOM restructuring later. No ad code or placeholder here now.
          -->
          <slot name="local-chooser" />

          <!-- Internal Links (optional, page-specific position) -->
          <slot name="links" />

          <!-- Quick Answer + expanded intro, below the practice experience -->
          <div class="mt-10 mb-6 max-w-xl">
            <div class="mb-3 text-[#1E1B4B] text-sm sm:text-base font-semibold leading-snug">
              <slot name="quick-answer" />
            </div>
            <div class="text-body text-base leading-relaxed">
              <slot name="intro" />
            </div>
          </div>
        </>
      ) : (
        <>
          <!-- Intro text (legacy order: above the widget, unchanged pending pilot results) -->
          <div class="mt-3 mb-6 text-body text-base leading-relaxed max-w-xl">
            <slot name="intro" />
          </div>

          <!-- Practice Widget -->
          <slot name="widget" />

          <!-- Internal Links -->
          <slot name="links" />
        </>
      )}

      <slot name="how-it-works" />
    </main>

    <aside class="hidden 2xl:block" aria-hidden="true"></aside>
  </div>

  <!-- Site Footer -->
  <footer class="border-t-2 border-[#E0E7FF] bg-[#EEF2FF] mt-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-[#6366F1]">
        <a href="/" class="hover:text-[#3730A3] transition-colors">Home</a>
        <a href="/addition" class="hover:text-[#3730A3] transition-colors">Addition</a>
        <a href="/subtraction" class="hover:text-[#3730A3] transition-colors">Subtraction</a>
        <a href="/multiplication" class="hover:text-[#3730A3] transition-colors">Multiplication</a>
        <a href="/division" class="hover:text-[#3730A3] transition-colors">Division</a>
        <a href="/arithmetic-speed-drill" class="hover:text-[#3730A3] transition-colors">Speed Drill</a>
        <a href="/math-worksheets" class="hover:text-[#3730A3] transition-colors">Worksheets</a>
        <a href="/progress" class="hover:text-[#3730A3] transition-colors">My Progress</a>
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-[#6366F1] mt-2">
        <a href="/1st-grade-math-practice" class="hover:text-[#3730A3] transition-colors">1st Grade</a>
        <a href="/2nd-grade-math-practice" class="hover:text-[#3730A3] transition-colors">2nd Grade</a>
        <a href="/3rd-grade-math-practice" class="hover:text-[#3730A3] transition-colors">3rd Grade</a>
        <a href="/4th-grade-math-practice" class="hover:text-[#3730A3] transition-colors">4th Grade</a>
        <a href="/5th-grade-math-practice" class="hover:text-[#3730A3] transition-colors">5th Grade</a>
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-[#6366F1] mt-2">
        <a href="/math-facts" class="hover:text-[#3730A3] transition-colors">Math Facts</a>
        <a href="/for-parents" class="hover:text-[#3730A3] transition-colors">For Parents</a>
        <a href="/for-teachers" class="hover:text-[#3730A3] transition-colors">For Teachers</a>
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-[#6366F1] mt-2">
        <a href="/about" class="hover:text-[#3730A3] transition-colors">About</a>
        <a href="/privacy" class="hover:text-[#3730A3] transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-[#3730A3] transition-colors">Terms of Service</a>
      </div>
      <p class="text-xs text-[#6B7280] mt-4">© {new Date().getFullYear()} Math Practice Online. Free arithmetic practice for students of all ages.</p>
    </div>
  </footer>
</BaseLayout>
