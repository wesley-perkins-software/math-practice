---
// Shared "H1 + contextual switcher" pattern, proven out on the
// /addition/1-digit prototype and now the standard header for every
// Addition practice page. Deliberately framework-agnostic (plain Astro
// markup + a vanilla <script>, no React) so any future practice family
// (Subtraction, Multiplication, …) can adopt it by passing its own
// heading/items — nothing here is Addition-specific except the data a page
// passes in.
//
// Layout: below `md` (768px) the heading and switcher are ALWAYS stacked
// (title row, switcher row), never sharing a row. This was a deliberate
// fix, not the original design: a shared single row with `flex-wrap` let a
// longer H1 (e.g. "2-Digit Addition Practice (No Carrying)") wrap onto a
// second line on narrow phones while a shorter one ("1-Digit Addition
// Practice") stayed on one — same component, two different heights, so the
// practice card below it started at a different Y position depending only
// on which page's title happened to be longer. Measured on a real render:
// at 320–430px the shared-row layout produced a 25px height gap between the
// two variants (one line vs. two).
//
// Fixing that per-title is what the brief calls out as the wrong move — no
// title-specific breakpoint could stay correct as new Addition-family pages
// are added. Stacking unconditionally below `md` sidesteps the question
// entirely: every page gets the same two-row shape (title alone gets the
// full container width, so none of the three current titles wrap within
// it — confirmed by rendering all three down to 320px), so the block's
// height is identical across pages by construction, not by reserving extra
// blank space to match a worst case.
//
// `md` (not `sm`, which is where the H1's own font size steps up to
// text-2xl) is deliberate: rendering the row layout right at `sm` put the
// larger font and the narrower shared-row width in the same 640px, and the
// longer titles wrapped again in row mode for exactly the same reason as
// the original bug — measured directly (640–767px reproduced the same
// height mismatch row layout was supposed to fix). `md` and up has
// confirmed headroom (rendered check: the longest title + switcher share a
// row without wrapping from 768px through desktop), so the two sit
// "beside" each other there, matching the originally approved desktop
// composition. A user zoomed in enough to shrink the effective layout
// viewport below `md` simply stays in the stacked, self-consistent layout
// instead of hitting that same collision again.
interface NavItem {
  id: string;
  label: string;
  href: string;
}

interface Props {
  /** The page's H1 text. */
  heading: string;
  /** The current page's id within `items`. */
  activeId: string;
  /** The full set of pages this switcher can jump to. */
  items: NavItem[];
  /** Accessible name / visible label for the switcher control. Defaults to "Change practice". */
  switcherLabel?: string;
}

const { heading, activeId, items, switcherLabel = 'Change practice' } = Astro.props;
---

<div class="flex flex-col items-start gap-1 md:flex-row md:items-center md:justify-between md:gap-x-3">
  {/*
    min-h-[2.5em] (2 lines at leading-tight's 1.25 ratio) reserves title
    space for the longest real title in this family even when a shorter one
    only needs one line — this is what makes the switcher (and therefore
    the practice card below it) land at the same Y position on every
    Addition page regardless of that page's own title length, without
    guessing a title-specific breakpoint. Only needed below `md`: above it
    the row layout has confirmed headroom for every current title to stay
    on one line, so the reserve is dropped there rather than leaving dead
    space no page will ever use.
  */}
  <h1 class="text-xl sm:text-2xl font-bold text-[#1E293B] leading-tight min-h-[2.5em] md:min-h-0">{heading}</h1>
  <nav aria-label={switcherLabel} class="font-practice -ml-2 md:ml-0">
    <details class="relative" data-dismissable-menu>
      <summary class="list-none flex items-center gap-1 text-base font-semibold text-[#4F46E5] cursor-pointer select-none px-2 py-1 -mr-2 rounded-lg hover:bg-[#F5F3FF] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#4F46E5] focus-visible:ring-offset-1">
        {switcherLabel}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
      </summary>
      {/*
        The menu keeps a static `right-0` default (flush with the trigger)
        and a small script below nudges it via an inline left/right override
        only if it would actually overflow the viewport — measured from real
        getBoundingClientRect() geometry every time it opens (and on resize
        while open), not guessed from a viewport-width breakpoint. That
        guess broke on a real device: flex-wrap in the row above is driven
        by real rendered content width (which varies with each page's own
        H1 length and system font metrics), so a fixed width breakpoint
        doesn't reliably predict whether the row above has wrapped.
        `max-w-[calc(100vw-2rem)]` below is a static CSS safety net only
        (keeps the menu narrower than the viewport even before the script
        runs); the script does the actual positioning.
      */}
      <div class="absolute right-0 top-full mt-1.5 z-20 w-56 max-w-[calc(100vw-2rem)] bg-white border border-[#E4E1F5] rounded-xl shadow-[0_8px_24px_rgba(79,70,229,0.16)] py-1.5">
        {items.map((item) => (
          item.id === activeId ? (
            <a href={item.href} aria-current="page" class="block px-3.5 py-2 text-sm font-semibold text-[#4F46E5] bg-[#F5F3FF]">{item.label}</a>
          ) : (
            <a href={item.href} class="block px-3.5 py-2 text-sm text-[#43405C] hover:bg-[#FAF9FE]">{item.label}</a>
          )
        ))}
      </div>
    </details>
  </nav>
</div>
<script>
  // Progressive enhancement over the native <details>/<summary> disclosure
  // above: closes on Escape (returning focus to the summary that opened
  // it, per standard focus-management practice), on an outside click, and
  // the moment the user resumes practice (focuses the answer, types, or
  // taps the on-screen keypad), so the switcher gets out of the way instead
  // of hovering open over the problem. That last case is detected via a
  // `[data-practice-instrument]` marker the practice widget renders itself
  // (see PracticeWidget.tsx) rather than hardcoding selectors for its
  // internals here, so this script stays framework-agnostic and
  // copy-pasteable. None of these close paths move focus except Escape,
  // which explicitly returns it to the summary — the others leave focus
  // exactly where the user put it.
  document.querySelectorAll<HTMLDetailsElement>('details[data-dismissable-menu]').forEach((details) => {
    const summary = details.querySelector('summary');
    const menu = details.querySelector<HTMLElement>(':scope > div');
    const close = () => { details.open = false; };

    // Keep the menu's default CSS position (right-0, flush with the
    // trigger) unless that would actually overflow the viewport, in which
    // case nudge it back in by exactly the overflow amount. Measures real
    // geometry instead of assuming a viewport-width breakpoint predicts
    // wrap state. A fixed page-edge margin (16px) matches the page's own
    // `px-4` content padding, so the menu never sits closer to the
    // viewport edge than the content column already does.
    const EDGE_MARGIN = 16;
    function clampMenuPosition() {
      if (!menu) return;
      // Reset to the CSS default (right-0) before measuring, so every call
      // starts from the same known position rather than compounding a
      // previous run's adjustment.
      menu.style.left = '';
      menu.style.right = '';
      const rect = menu.getBoundingClientRect();
      const viewportWidth = document.documentElement.clientWidth;
      if (rect.right > viewportWidth - EDGE_MARGIN) {
        // `right` is a relative offset from the containing block's own
        // right edge, so adding the overflow amount to it shifts the menu
        // left by exactly that many px in viewport space — no containing-
        // block math needed for this direction.
        menu.style.right = `${Math.max(0, rect.right - (viewportWidth - EDGE_MARGIN))}px`;
      } else if (rect.left < EDGE_MARGIN) {
        // `left` IS relative to the containing block (<details>), not the
        // viewport, so converting a target viewport position back to a
        // `left` offset requires the containing block's own viewport
        // position.
        const detailsRect = details.getBoundingClientRect();
        menu.style.right = 'auto';
        menu.style.left = `${EDGE_MARGIN - detailsRect.left}px`;
      }
    }
    details.addEventListener('toggle', () => {
      if (details.open) clampMenuPosition();
    });
    window.addEventListener('resize', () => {
      if (details.open) clampMenuPosition();
    });

    document.addEventListener('click', (e) => {
      if (details.open && e.target instanceof Node && !details.contains(e.target)) {
        close();
      }
    });
    details.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && details.open) {
        e.preventDefault();
        close();
        summary?.focus();
      }
    });
    document.querySelectorAll<HTMLElement>('[data-practice-instrument]').forEach((instrument) => {
      instrument.addEventListener('pointerdown', () => { if (details.open) close(); });
      instrument.addEventListener('focusin', () => { if (details.open) close(); });
    });
  });
</script>
