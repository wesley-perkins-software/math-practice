---
/**
 * Shared site header (brand + primary nav), used by PracticeLayout and
 * HubLayout.
 *
 * History: originally a flat 7-link row with two states — no nav (<640px,
 * "reachable via the footer") or the full row (>=640px), with a dropdown
 * trigger filling the 640-1024px gap where the full row didn't fit
 * (measured: real horizontal overflow up to ~800px, awkward multi-line
 * labels up to ~1000px). That measurement work is preserved below.
 *
 * Redesign: Addition/Subtraction/Multiplication/Division are now
 * disclosure menus (practice-variant links, plus a nested 1-12 grid for
 * Times Tables/Divide By) instead of plain links, so the header can carry
 * all practice-switching navigation that used to live beside the H1 or
 * inside the practice widget. That nested IA needs to be reachable on a
 * phone, so the old "<640px: no nav at all" decision is reversed here —
 * every width now gets a working menu trigger; only the *presentation*
 * (full inline row vs a dropdown/panel trigger) still depends on width,
 * using the same three width tiers as before:
 *   <640px (`sm`)         -> menu trigger, dropdown panel with nested
 *                            per-operation disclosures (mobile/narrow tablet)
 *   640-1320px (`sm`-1320)  -> same trigger/panel treatment (more headroom,
 *                            same panel works unchanged)
 *   >=1320px               -> full inline row; each operation is its own
 *                            dropdown, Times Tables/Divide By nest a second
 *                            flyout for the 1-12 grid
 * Tablet landscape can land on either tier depending on the exact device
 * width — verified at validation time rather than adding a dedicated
 * breakpoint.
 *
 * Static-link count grew from 3 to 4 ("Create Classroom Practice") with no
 * spare room left in the row: the pre-existing 7 items already consumed the
 * full max-w-5xl (1024px) content width with zero slack at every desktop
 * width, so an 8th item measurably overflowed in the 1024-1100px band.
 * Widening the header's own container to max-w-7xl (1280px) + raising the
 * split to `xl` (1280px) fit the shorter "Create Practice" label tried
 * first, but re-measuring against the final, longer "Create Classroom
 * Practice" label (logo + all 8 items + gaps = ~1216px, +48px header padding
 * = ~1264px minimum) left only ~16px of margin at 1280px — closer to
 * another zero-slack fit than real breathing room. Container/breakpoint
 * moved together to a content-driven custom value, `max-w-[1320px]` /
 * `min-[1320px]:*`, giving ~56px of real slack (manifesting as extra gap
 * between the logo and the first nav item, since the row's own two flex
 * children — logo, nav — are pushed to opposite ends by `justify-between`;
 * the nav's own content never actually touches the container's edge).
 * 1320 is also deliberately clear of 1366px, one of the most common laptop
 * viewport widths, so those screens land solidly inside the full-row tier
 * rather than near a boundary. Page/body/footer content elsewhere keeps its
 * own separate max-w-5xl, unaffected.
 *
 * All interactivity here is plain `<details>/<summary>` + vanilla script,
 * matching the file's original convention — no React/hydration cost for a
 * component that renders above the fold on every page, since `<details>`
 * already gives Enter/Space-to-toggle and native disclosure semantics.
 */
import { OPERATION_MENUS, OPERATION_ORDER, operationMenuEntries } from '@/data/practiceNav';
import NumberGrid from './NumberGrid.astro';

interface Props {
  /** Vertical header padding — the two call sites historically differed slightly (py-2.5 vs py-3.5). */
  paddingY?: string;
}

const { paddingY = 'py-2.5' } = Astro.props;

const staticLinks = [
  { href: '/arithmetic-speed-drill/', label: 'Speed Drill' },
  { href: '/math-worksheets/', label: 'Worksheets' },
  { href: '/create/', label: 'Create Classroom Practice' },
  { href: '/progress/', label: 'My Progress' },
];

const chevron = 'M6 9l6 6 6-6';
---

<header class="bg-[#1E1B4B] sticky top-0 z-20 shadow-[0_1px_0_0_#312E81]">
  <div class={`max-w-[1320px] mx-auto px-4 sm:px-6 ${paddingY} flex items-center justify-between`}>
    <a href="/" class="flex items-center gap-2 group shrink-0">
      <span class="w-8 h-8 rounded-lg bg-[#4F46E5] flex items-center justify-center select-none group-hover:bg-[#6366F1] transition-colors shrink-0"><svg viewBox="0 0 24 24" width="16" height="16" fill="white" aria-hidden="true"><path d="M10 3H14V10H21V14H14V21H10V14H3V10H10Z"/></svg></span>
      <span class="text-lg font-bold text-white tracking-tight whitespace-nowrap">Math Practice Online</span>
    </a>

    <!-- Desktop nav: only at widths measured to fit all 8 items on one line with real breathing room (1320px+, paired with the header's own max-w-[1320px] container — see the header comment history for the measurement behind this number). -->
    <nav aria-label="Primary" class="hidden min-[1320px]:flex items-center gap-1">
      {OPERATION_ORDER.map((op) => {
        const menu = OPERATION_MENUS[op];
        const label = menu.hub.label.replace(' Practice', '');
        return (
          <details class="relative" data-dismissable-menu data-op-group="desktop">
            <summary class="list-none flex items-center gap-0.5 px-3 py-1.5 rounded-lg text-sm font-medium text-[#C7D2FE] hover:text-white hover:bg-white/10 transition-all cursor-pointer select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60">
              {label}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5" aria-hidden="true"><path d={chevron} /></svg>
            </summary>
            <div class="absolute left-0 top-full mt-2 z-20 w-60 max-w-[calc(100vw-2rem)] bg-white border border-[#E4E1F5] rounded-xl shadow-[0_8px_24px_rgba(30,27,75,0.24)] py-1.5">
              <a href={menu.hub.href} class="block px-3.5 py-2 text-sm font-semibold text-[#4F46E5] hover:bg-[#F5F3FF]">{menu.hub.label}</a>
              {operationMenuEntries(menu).map((entry) => entry.type === 'grid' ? (
                <details class="relative" data-dismissable-menu>
                  <summary class="list-none flex items-center justify-between px-3.5 py-2 text-sm text-black hover:bg-[#FAF9FE] hover:text-[#4F46E5] cursor-pointer select-none">
                    {entry.label}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 -rotate-90" aria-hidden="true"><path d={chevron} /></svg>
                  </summary>
                  <div class="absolute left-full top-0 ml-1.5 z-30 w-48 bg-white border border-[#E4E1F5] rounded-xl shadow-[0_8px_24px_rgba(30,27,75,0.24)] p-2.5">
                    <NumberGrid mode="menu" basePath={entry.basePath} max={entry.max} />
                  </div>
                </details>
              ) : (
                <a href={entry.href} class="block px-3.5 py-2 text-sm text-black hover:bg-[#FAF9FE] hover:text-[#4F46E5]">{entry.label}</a>
              ))}
            </div>
          </details>
        );
      })}
      {staticLinks.map((link) => (
        <a href={link.href} class="px-3 py-1.5 rounded-lg text-sm font-medium text-[#C7D2FE] hover:text-white hover:bg-white/10 transition-all">{link.label}</a>
      ))}
    </nav>

    <!-- Menu trigger: renders below 1320px, including phones (<640px) -->
    <details class="relative block min-[1320px]:hidden" data-site-nav-menu>
      <summary class="list-none flex items-center justify-center w-10 h-10 rounded-lg text-[#C7D2FE] hover:text-white hover:bg-white/10 transition-all cursor-pointer select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60">
        <span class="sr-only">Menu</span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" width="22" height="22" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <div class="absolute right-0 top-full mt-2 z-20 w-72 max-w-[calc(100vw-2rem)] max-h-[calc(100vh-5rem)] overflow-y-auto bg-white border border-[#E4E1F5] rounded-xl shadow-[0_8px_24px_rgba(30,27,75,0.24)] py-1.5">
        {OPERATION_ORDER.map((op) => {
          const menu = OPERATION_MENUS[op];
          const label = menu.hub.label.replace(' Practice', '');
          return (
            <details class="border-b border-[#F0EEFC] last:border-b-0" data-dismissable-menu data-op-group="mobile">
              <summary class="list-none flex items-center justify-between px-3.5 py-2.5 text-[15px] font-semibold text-[#1E1B4B] cursor-pointer select-none">
                {label}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[#8983B8] shrink-0" aria-hidden="true"><path d={chevron} /></svg>
              </summary>
              <div class="pb-2 pl-3.5">
                <a href={menu.hub.href} class="block px-3 py-2 text-sm font-semibold text-[#4F46E5]">{menu.hub.label}</a>
                {operationMenuEntries(menu).map((entry) => entry.type === 'grid' ? (
                  <details data-dismissable-menu>
                    <summary class="list-none flex items-center justify-between px-3 py-2 text-sm text-black cursor-pointer select-none">
                      {entry.label}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-[#8983B8] shrink-0" aria-hidden="true"><path d={chevron} /></svg>
                    </summary>
                    <div class="px-3 py-2">
                      <NumberGrid mode="menu" basePath={entry.basePath} max={entry.max} />
                    </div>
                  </details>
                ) : (
                  <a href={entry.href} class="block px-3 py-2 text-sm text-black">{entry.label}</a>
                ))}
              </div>
            </details>
          );
        })}
        <div class="pt-1.5">
          {staticLinks.map((link) => (
            <a href={link.href} class="block px-3.5 py-2.5 text-[15px] text-black hover:bg-[#FAF9FE] hover:text-[#4F46E5]">{link.label}</a>
          ))}
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  // Shared open/close behavior for every disclosure menu in the header:
  // the top-level mobile trigger (`data-site-nav-menu`) and every operation
  // dropdown/nested flyout (`data-dismissable-menu`).
  //
  // This site uses Astro's <ClientRouter /> (View Transitions) sitewide, so
  // navigating between two pages that both render this header does NOT
  // reload the document — the old header's DOM (including these listeners)
  // is discarded and a fresh, entirely unbound copy swaps in. A plain
  // top-level script only runs once, the first time it's encountered, so
  // without re-binding, every page you reach via a client-side navigation
  // would silently lose exclusivity/outside-click/Escape entirely (native
  // <details> still opens/closes on click, just with none of this logic) —
  // that was the actual defect behind "multiple menus stay open," not an
  // event-ordering race in the same-page listeners themselves.
  //
  // Fix: per-element binding (exclusivity, Escape, position clamping) is
  // wrapped in bindMenus() and re-run on every `astro:page-load`, which
  // fires after the initial load AND after every transition. The
  // page-content-agnostic listeners (click-outside, focusin, pointerdown/
  // touchstart) re-query the DOM at event time rather than closing over a
  // snapshot, so they're attached exactly once and never go stale.
  const DISMISSABLE_SELECTOR = 'details[data-site-nav-menu], details[data-dismissable-menu]';
  const BOUND_ATTR = 'data-menu-bound';
  const EDGE_MARGIN = 16;

  function clampMenuPosition(details: HTMLDetailsElement) {
    const menu = details.querySelector<HTMLElement>(':scope > div');
    if (!menu) return;
    menu.style.left = '';
    menu.style.right = '';
    const rect = menu.getBoundingClientRect();
    const viewportWidth = document.documentElement.clientWidth;
    if (rect.right > viewportWidth - EDGE_MARGIN) {
      menu.style.right = '0';
      menu.style.left = 'auto';
    }
    if (rect.left < EDGE_MARGIN) {
      menu.style.left = '0';
      menu.style.right = 'auto';
    }
  }

  function closeAllMenus() {
    document.querySelectorAll<HTMLDetailsElement>(DISMISSABLE_SELECTOR).forEach((d) => {
      if (d.open) d.removeAttribute('open');
    });
  }

  function bindMenus() {
    document.querySelectorAll<HTMLDetailsElement>(DISMISSABLE_SELECTOR).forEach((details) => {
      // Idempotent: astro:page-load can fire on a header that (rarely)
      // wasn't replaced, so already-bound elements are skipped rather than
      // double-bound.
      if (details.hasAttribute(BOUND_ATTR)) return;
      details.setAttribute(BOUND_ATTR, '');

      const summary = details.querySelector('summary');

      details.addEventListener('toggle', () => {
        if (!details.open) return;
        clampMenuPosition(details);

        // Exclusivity: when a top-level operation <details> (Addition/
        // Subtraction/Multiplication/Division) becomes open, synchronously
        // remove the `open` attribute from every other top-level <details>
        // that shares its `data-op-group` (the desktop row, or the mobile
        // accordion panel — two independent groups) — at most one is ever
        // open per group. The selector is scoped to `[data-op-group]`
        // specifically, so nested Times Tables/Divide By flyouts (which
        // carry no group) are never touched as if they were peers, and a
        // closing parent doesn't reset a nested flyout's own open state.
        const group = details.dataset.opGroup;
        if (!group) return;
        document.querySelectorAll<HTMLDetailsElement>(`details[data-op-group="${group}"]`).forEach((other) => {
          if (other !== details && other.open) other.removeAttribute('open');
        });
      });

      window.addEventListener('resize', () => {
        if (details.open) clampMenuPosition(details);
      });

      // Escape closes the innermost open menu and returns focus to its own
      // trigger (no stopPropagation, so a second Escape closes a parent
      // menu too — a second `[data-dismissable-menu]` ancestor, if open,
      // gets its own Escape keydown next since focus is still inside it).
      details.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && details.open) {
          e.preventDefault();
          details.removeAttribute('open');
          summary?.focus();
        }
      });
    });
  }

  // Click/tap anywhere not contained by a given open menu closes it —
  // covers both "elsewhere on the page" and switching between sibling
  // menus via mouse or touch (the toggle-based exclusivity above is the
  // keyboard-safe version of the same rule). Re-queries at event time, so
  // this single listener keeps working after every client-side navigation.
  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Node)) return;
    document.querySelectorAll<HTMLDetailsElement>(DISMISSABLE_SELECTOR).forEach((d) => {
      if (d.open && !d.contains(e.target as Node)) d.removeAttribute('open');
    });
  });

  // Resuming meaningful interaction with the practice widget — focusing the
  // answer input, tapping/clicking the keypad, or any other pointer/touch
  // interaction inside the practice surface — closes every open header
  // menu. A menu left open while a student is mid-problem is a bug, not a
  // feature.
  document.addEventListener('focusin', (e) => {
    if (e.target instanceof Element && e.target.closest('[data-practice-instrument]')) {
      closeAllMenus();
    }
  });
  (['pointerdown', 'touchstart'] as const).forEach((type) => {
    document.addEventListener(type, (e) => {
      if (e.target instanceof Element && e.target.closest('[data-practice-instrument]')) {
        closeAllMenus();
      }
    }, { passive: true });
  });

  document.addEventListener('astro:page-load', bindMenus);
</script>
